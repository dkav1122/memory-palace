# Orchestrator secrets — copy the values you need into .env.local (repo root)
# or orchestrator/.env. Non-secret settings live in workflow.config.json.

# Cursor SDK (cloud agents) — required from Phase 2 on
CURSOR_API_KEY=

# Jira REST v3 (basic auth) — required for Phase 0 validation and Phase 1+ runtime
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_BASE_URL overrides jira.baseUrl in workflow.config.json (optional)
JIRA_BASE_URL=https://dixonsworkspace-13267887.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Optional: orchestrator HTTP port (default 4100)
# ORCH_PORT=4100

# Portal (game app) — orchestrator API base URL used by /support pages in the browser
# Only needed if the orchestrator is not on the default http://localhost:4100
# NEXT_PUBLIC_ORCH_URL=http://localhost:4100

# Memory Palace — AI card image generation (required for "Describe it" on /deck)
OPENAI_API_KEY=
# Optional overrides (defaults: gpt-image-1, low)
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=low
