{
  "name": "memory-palace-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise workflow orchestrator: intake -> triage -> prioritization -> execution -> PR, mirrored to Jira.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "validate:jira": "tsx scripts/validate-jira.ts",
    "validate:prioritization": "tsx scripts/validate-prioritization.ts",
    "validate:execution": "tsx scripts/validate-execution.ts"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.27",
    "@hono/node-server": "^2.1.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
